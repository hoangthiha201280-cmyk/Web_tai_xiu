--==================================================
-- FOV TOGGLE
--==================================================

AimbotTab:CreateToggle({

    Name = "FOV Circle",

    CurrentValue = false,

    Flag = "Toggle_FOV",

    Callback = function(Value)

        FOVEnabled = Value

        updateFOV()

    end
