--==================================================
-- FOV SLIDER
--==================================================

AimbotTab:CreateSlider({

    Name = "Kích Thước Vòng FOV",

    Range = {
        10,
        500
    },

    Increment = 5,

    Suffix = "px",

    CurrentValue = 100,

    Flag = "Slider_FOV",

    Callback = function(Value)

        FOVRadius = Value

        updateFOV()

    end
})

--==================================================
-- TARGET PART
--==================================================

AimbotTab:CreateDropdown({

    Name = "Vị Trí Ưu Tiên Aim",

    Options = {
        "Đầu (Head)",
        "Thân (Torso)",
        "Gần Nhất (Closest)"
    },

    CurrentOption = {
        "Đầu (Head)"
    },

    MultipleOptions = false,

    Flag = "Dropdown_Target",

    Callback = function(Option)

        local selected =
            Option[1] or Option

        if selected == "Đầu (Head)" then

            TargetPart = "Head"

        elseif selected == "Thân (Torso)" then

            TargetPart = "HumanoidRootPart"

        elseif selected == "Gần Nhất (Closest)" then

            TargetPart = "HumanoidRootPart"
        end

    end
})

--==================================================
-- DEMO TARGET CHECK
--==================================================

AimbotTab:CreateButton({

    Name = "Kiểm Tra Mục Tiêu Trong FOV",

    Callback = function()

        local target =
            getClosestTarget()

        if target then

            Rayfield:Notify({

                Title = "FOV Target",

                Content =
                    "Mục tiêu: " ..
                    target.DisplayName,

                Duration = 2,

                Image = 4483362458
            })

        else

            Rayfield:Notify({

                Title = "FOV Target",

                Content =
                    "Không có người chơi trong FOV.",

                Duration = 2,

                Image = 4483362458
            })
        end
    end
})

